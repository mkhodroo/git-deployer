{
    "name": "behin/git-deployer",
    "description": "پکیج دپلوی گیت برای لاراول - اتصال ریپازیتوری گیت به دایرکتوری هاست با امکان آپدیت، مشاهده تاریخچه و بازگشت به هر کامیت",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Behin\\GitDeployer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Behin\\GitDeployer\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
